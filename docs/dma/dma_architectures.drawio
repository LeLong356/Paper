        <mxCell id="i32__r1__c1" value="Proposed read-only DMA for the MHSA accelerator: DRAM to BRAM over AXI4 INCR bursts. Address issue and data receive are separate state machines linked by a burst-information FIFO, so up to a configurable number of bursts are in flight and the DRAM latency is hidden. With one outstanding burst it behaves like page 02." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i32__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
