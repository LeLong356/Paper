        <mxCell id="i24__r1__c1" value="Simplest DMA class: the processor writes source, destination and length into control registers, sets a start bit and polls a done flag. One transfer runs at a time and bursts are issued strictly one after another. Matches the AMD AXI DMA direct-register mode and the DMA v0 spec of the handoff." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r1" vlsit_native_table="1">
