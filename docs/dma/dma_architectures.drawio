        <mxCell id="i29__r1__c1" value="Generic modular DMA as decomposed by Benz et al.: a front-end binds the engine to the processor, an optional mid-end splits multi-dimensional transfers into one-dimensional ones, and a back-end legalizes and executes them on the memory bus with read and write sides decoupled by a buffer." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r1__c2" value="Benz et al., IEEE TC 2023, Sec. 2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r1" vlsit_native_table="1">
