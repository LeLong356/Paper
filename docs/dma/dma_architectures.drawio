        </mxCell>
        <mxCell id="i28__r1__c1" value="Descriptor-driven DMA: the processor builds a linked list of transfer descriptors in memory and only hands the engine the list head and tail. The engine fetches descriptors, runs each transfer and writes the completion status back into the descriptor, so many non-contiguous transfers run without processor involvement." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i28__r1" vlsit_native_table="1">
