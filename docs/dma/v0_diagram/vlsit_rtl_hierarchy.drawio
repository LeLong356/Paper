          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r1__c1" value="Read-only DMA (v0): copies one contiguous DRAM region (address, length) into one bank of the ping-pong weight buffer over an AXI4 read interface (32-bit data, INCR bursts of at most 16 beats, no 4 KB crossing). One request at a time; a request FSM sequences five child blocks: legalizer, address FSM, burst info FIFO, data FSM and BRAM writer. On a response error the data side drains all outstanding beats before the error is reported." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r1__c2" value="dma_v0_4block.md §1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r1" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r1__c3" value="REQ, AXAR, AXR, BWR, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r1" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__t" vlsit_native_table="1">
          <mxGeometry y="156" width="2400" height="124" as="geometry" />
        </mxCell>
        <mxCell id="i40__r2__c0" value="Request FSM (FG of dma_rd)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r2" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="124" as="geometry">
            <mxRectangle width="330" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r2__c1" value="Captures one request from the controller on a valid/ready handshake into internal registers, then checks it: the length must be non-zero and a multiple of 32 bytes and the destination range must fit in one 6144-word bank, otherwise the request ends in a configuration error. It waits until the ping-pong buffer reports a free bank, loads the legalizer and the writer in the same cycle, and lets the address and data sides run concurrently. On completion of the last word, or on a read error (after aborting the legalizer so that no new burst is issued), it waits until the address side is idle and no burst is in flight, then emits a one-cycle done or error indication with a held error code." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="124" as="geometry">
            <mxRectangle width="1480" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r2__c2" value="dma_v0_4block.md §2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r2" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="124" as="geometry">
            <mxRectangle width="230" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r2__c3" value="REQ, LOAD, ar_done, RST, WLD, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r2" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="124" as="geometry">
            <mxRectangle width="360" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__t" vlsit_native_table="1">
          <mxGeometry y="280" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i40__r3__c0" value="u_legal (burst_legalizer)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r3" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r3__c1" value="Splits (start address, total beats) into a sequence of bursts of min(16, beats left, beats to the next 4 KB boundary). It holds only the current address and the remaining beat count, offers one burst at a time, advances both only on an accepted handshake, flags the final burst, and clears the remaining count on an abort." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r3__c2" value="dma_v0_4block.md §3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r3" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r3__c3" value="LOAD, BST, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r3" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r4" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__t" vlsit_native_table="1">
          <mxGeometry y="360" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i40__r4__c0" value="u_ar (ar_fsm)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r4" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r4__c1" value="Drives the AXI4 read address channel. When a burst is offered and the info FIFO is not full, it registers the burst and holds address and length (beats minus one) stable with valid asserted until the slave accepts; on acceptance it pushes the burst length and final flag into the info FIFO and consumes the burst. It reports idle-with-no-pending-burst as a level to the request FSM." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r4" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r4__c2" value="dma_v0_4block.md §4" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r4" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r4__c3" value="BST, PUSH, ar_done, AXAR, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r4" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r5" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__t" vlsit_native_table="1">
          <mxGeometry y="440" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i40__r5__c0" value="u_info (burst_info_fifo)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r5" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r5__c1" value="FIFO of depth MAX_OUT (1 in v0: one register with a valid flag) that stores the length and final flag of every burst accepted on the address channel and not yet completed on the data channel. Its occupancy is the number of bursts in flight, so the address side stalls when it is full and the data side waits while it is empty." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r5" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r5__c2" value="dma_v0_4block.md §5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r5" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r5__c3" value="PUSH, POP, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r5" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r6" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__t" vlsit_native_table="1">
          <mxGeometry y="520" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i40__r6__c0" value="u_r (r_fsm)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r6" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r6__c1" value="Receives the AXI4 read data channel. For the burst at the head of the info FIFO it accepts beats while the writer is ready, forwards each beat, counts beats against the expected length, checks the last flag and the response code, and pops the FIFO at the end of the burst. On an error response or a misplaced last flag it reports the error once, stops forwarding, and keeps accepting and discarding beats until every burst in flight is drained." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r6" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r6__c2" value="dma_v0_4block.md §6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r6" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r6__c3" value="POP, RST, BEAT, AXR, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r6" vlsit_native_table="1">
