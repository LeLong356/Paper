            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i40__r7__c1" value="Packs eight 32-bit beats into one 256-bit word (first beat in the low bits), writes the word to the ping-pong buffer at the current word address and increments the address; it counts beats independently of burst boundaries, compares the word count with the requested length and signals when the last word is written. It also forwards the buffer's free-bank status to the request FSM." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i40__r7" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
