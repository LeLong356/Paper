          </mxGeometry>
        </mxCell>
        <mxCell id="i31__r1__c1" value="[EXISTS, Long] Two 6144 x 256 synchronous BRAM banks that swap roles. A small role FSM keeps which bank is being written and which is being read, toggles the write bank on write-done and the read bank on read-done, and keeps a full flag per bank. Writes are steered to the write bank; reads go to the read bank and the output is selected with the read-bank select delayed by one cycle because the BRAM has one cycle of read latency." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i31__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i31__r1__c2" value="memory 2026-10-27; wave/bram_pp.json" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i31__r1" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
