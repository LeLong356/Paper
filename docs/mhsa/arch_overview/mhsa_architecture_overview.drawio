        <mxCell id="i46__r2__c0" value="u_csr (acc_csr_axil)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r2" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i46__r2__c1" value="[EXISTS slave / PROPOSED map] AXI4-Lite slave holding the task registers: CTRL (self-clearing START, CLR), STATUS (BUSY, sticky DONE and ERR with an error code, write-one-to-clear), DRAM base addresses of X, Wq, Wk, Wv, sequence length, head configuration and three performance counters. Configuration writes are blocked while busy. DONE reflects the end of the whole task, not of one chunk." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i46__r2__c2" value="arch doc 5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r2" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
