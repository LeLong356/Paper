        <mxCell id="i28__r3__c1" value="[EXISTS] Address decoder of the data bus. Accesses to the low 64 KiB go to the data memory; accesses to the 0x4xxx_xxxx window go to the bridge. It returns the response of the selected target to the CPU." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i28__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
