          </mxGeometry>
        </mxCell>
        <mxCell id="i46__r6__c1" value="[EXISTS] Ping-pong weight buffer: two banks of 6144 x 256 bit (196 608 B = one 768 x 256 INT8 chunk each). One bank is written by the DMA while the other is read by the GEMM core; the roles swap when a write and a read are complete. Expanded on page 03_LEVEL_3_BRAM_PP." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r6" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
