          </mxGeometry>
        </mxCell>
        <mxCell id="i28__r1__c1" value="[EXISTS] VC707 SoC top. A VexRiscv CPU runs firmware from an instruction memory and reaches a data memory and the accelerator register window through an address decoder; the accelerator window is converted to AXI4-Lite by a bridge. The MHSA accelerator is the only block that reads DRAM (MIG DDR3, external) for tensor data; the CPU never touches tensor data." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i28__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i28__r1__c2" value="handoff_mhsa_dma.md 1, 3; arch doc 1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i28__r1" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i28__r1__c3" value="MAXI, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i28__r1" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
