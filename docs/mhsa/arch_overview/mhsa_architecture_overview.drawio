          </mxGeometry>
        </mxCell>
        <mxCell id="i28__r2__c1" value="[EXISTS] RV32 CPU. It fetches instructions on its instruction bus and issues one data-bus transaction at a time. In this system its firmware only writes the task configuration into the accelerator registers, sets START and polls the DONE flag; it never moves tensor data." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i28__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
