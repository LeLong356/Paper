        <mxCell id="i46__r3__c0" value="u_ctrl (acc_controller)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r3" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i46__r3__c1" value="[FIXED role / PROPOSED FSM] Task sequencer. On START it loads X, then for each weight matrix and each of its three chunks requests the chunk from the DMA, waits for the chunk-done pulse, starts the GEMM core and waits for it; then runs the score, softmax and score x V stages and the output step. Any DMA error or a watchdog timeout ends the task in ERR. It also counts cycles spent waiting for DMA and computing." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i46__r3__c2" value="arch doc 1, 6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r3" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
