        <mxCell id="i33__2" value="Architecture mode: drawn from project documents, not from RTL. [EXISTS] = block already written; [FIXED] = decided by Long; [PROPOSED] = Claude proposal; dashed outline = location or existence not decided. FG = functional group of the module own logic. [pulse] = one-cycle signal, [level] = held value." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;fontColor=#000000;spacing=2;" vertex="1" parent="1" vlsit_library_sha256="D1631ACF98A920526B235E8970FEDDC9305EA2F0D6A35C6529CD220D62AFABB6" vlsit_library_entry="0" vlsit_library_cell="2" vlsit_library_instance="i33">
