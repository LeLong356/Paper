            <mxRectangle width="330" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i54__r4__c1" value="Drives the AXI4 address channel: holds address and length (beats minus one) stable until accepted, never lowers the valid early, and records each accepted burst in the info FIFO while fewer than MAX_OUT bursts are in flight." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i54__r4" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i54__r4__c2" value="dma_v0_4block.md 4a" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i54__r4" vlsit_native_table="1">
