        <mxCell id="i46__r5__c0" value="u_dma (dma_rd)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r5" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i46__r5__c1" value="[FIXED] Read-only DMA. Accepts one request at a time (no queue), splits it into legal AXI4 INCR bursts (at most 16 beats, no 4 KB crossing), receives the data, packs beats into 256-bit words and writes them to the destination BRAM; reports chunk done or error. No stride support: software lays out every chunk contiguously in DRAM. Expanded on page 03_LEVEL_3_DMA." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r5" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
