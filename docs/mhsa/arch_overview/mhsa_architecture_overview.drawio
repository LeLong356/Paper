          <mxGeometry x="1810" width="230" height="102" as="geometry">
            <mxRectangle width="230" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i46__r1__c3" value="AXIL, MAXI, OUT, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r1" vlsit_native_table="1">
