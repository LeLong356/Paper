          </mxGeometry>
        </mxCell>
        <mxCell id="i31__r2__c1" value="Holds the write-bank and read-bank selects and the two full flags. Sets a full flag and toggles the write bank when the last word of a bank is written; clears it and toggles the read bank when the reader reports done. Reports a free bank to the DMA and the full flags to the reader. Synchronous reset (open: consistency with other blocks)." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i31__r2" vlsit_native_table="1">
