        <mxCell id="i28__r4__c1" value="[EXISTS] Converts a single data-bus command into one AXI4-Lite read or write transaction and returns the read data or write response. Verified at 5 cycles per write and 4 per read." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i28__r4" vlsit_native_table="1">
