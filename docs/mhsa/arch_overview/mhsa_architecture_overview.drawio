        </mxCell>
        <mxCell id="i54__r5__c1" value="Small FIFO of {beats, last} per burst in flight; depth MAX_OUT (1 in v0, a register with a valid flag). Its occupancy is the in-flight burst count." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i54__r5" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="36" as="geometry">
            <mxRectangle width="1480" height="36" as="alternateBounds" />
          </mxGeometry>
