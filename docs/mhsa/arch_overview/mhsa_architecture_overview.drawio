            <mxRectangle width="330" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i46__r4__c1" value="[EXISTS] Row softmax over the attention scores of one head; started by the controller, reads score rows and writes probabilities back. The 1/sqrt(d) scale is not yet placed (open)." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i46__r4" vlsit_native_table="1">
