            <mxRectangle width="330" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i54__r3__c1" value="Splits (address, total beats) into bursts of min(16, beats left, beats to the next 4 KB boundary); holds only the current address and the remaining beat count and advances them only on a handshake." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i54__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
