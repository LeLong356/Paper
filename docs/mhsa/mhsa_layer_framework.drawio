<mxfile host="app.diagrams.net"><diagram name="1. Khung 1 lớp MHSA" id="7725451068327039766"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:20px&quot;&gt;Khung 1 lớp MHSA (dùng lại cho mọi layer, mọi cấu hình S / H)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Giả định: int8, D = 768, d_h = D/H, TILE = 16 (chờ Long xác nhận). Số BRAM ghi trong ngoặc là ví dụ H=12, S=512." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="45" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Cổng bộ nhớ ngoài&lt;/b&gt;&lt;br&gt;&lt;br&gt;(DDR / UART / DMA:&lt;br&gt;làm sau, chỉ cần&lt;br&gt;1 cổng đọc + 1 cổng ghi)&lt;br&gt;&lt;br&gt;Đọc: X, W, bias&lt;br&gt;Ghi: Out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="170" height="560" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;CSR cấu hình (RISC-V ghi)&lt;/b&gt;&lt;br&gt;S, H, d_h, base_X, base_W(layer), base_bias, base_Out&lt;br&gt;scale_q (đã gộp 1/√d_h), scale_k, scale_v, scale_p, scale_o&lt;br&gt;START / DONE / BUSY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="420" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Bộ điều khiển layer (FSM + bộ đếm h, i, j, k)&lt;/b&gt;&lt;br&gt;LOAD_X → for h in 0..H-1:&lt;br&gt;&amp;nbsp;&amp;nbsp;PROJ_K → PROJ_V → PROJ_Q → ATTN (từng khối hàng i)&lt;br&gt;→ PROJ_O (+bias, +residual) → STORE / giữ lại cho layer sau&lt;br&gt;→ DONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="250" y="215" width="420" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Buffer on-chip (BRAM)&lt;/b&gt; — màu = thời gian sống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="720" y="85" width="400" height="25" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;X_buf&lt;/b&gt;  S × D int8&lt;br&gt;(384 KB) sống cả layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="115" width="260" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Concat_buf&lt;/b&gt;  S × D int8&lt;br&gt;(384 KB) sống cả layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="185" width="260" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Bias_buf&lt;/b&gt;  4 × D int32 (12 KB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="255" width="260" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;W_tile ping / pong&lt;/b&gt; = B_Bram&lt;br&gt;2 × (D × TILE) int8 (24 KB)&lt;br&gt;1 lát cột của Wq/Wk/Wv/Wo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="315" width="260" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Q_h&lt;/b&gt;  S × d_h int8 (32 KB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="395" width="260" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;K_h&lt;/b&gt;  S × d_h int8, lưu theo hàng (32 KB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="455" width="260" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;V_hᵀ&lt;/b&gt;  d_h × S int8, lưu theo hàng (32 KB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="515" width="260" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Score ping / pong&lt;/b&gt;&lt;br&gt;2 × (TILE × S) int32 (64 KB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="575" width="260" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;P_buf&lt;/b&gt;  TILE × S int8 (8 KB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="645" width="260" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;MUX A&lt;/b&gt;&lt;br&gt;X / Q_h / P&lt;br&gt;/ Concat / Wvᵀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="300" width="90" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;MUX B&lt;/b&gt;&lt;br&gt;W_tile / K_h&lt;br&gt;/ V_hᵀ / X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="420" width="90" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;GEMM core (đã có)&lt;/b&gt;&lt;br&gt;A_Bram, B_Bram&lt;br&gt;L0: local_a (hàng A), local_b (cột B)&lt;br&gt;Idle→Load→Compute→&lt;br&gt;Write_C_Acc→Write_C_Bram&lt;br&gt;&lt;br&gt;acc int32: lần k đầu nạp &lt;b&gt;bias&lt;/b&gt;&lt;br&gt;thay vì 0 (trạng thái N)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="300" width="250" height="210" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Requant&lt;/b&gt;&lt;br&gt;int32 → int8&lt;br&gt;(× scale, &amp;gt;&amp;gt; shift, clamp)&lt;br&gt;+ residual X ở PROJ_O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1520" y="300" width="200" height="90" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Softmax (đã có)&lt;/b&gt;&lt;br&gt;chạy song song với GEMM&lt;br&gt;đọc score, ghi P int8&lt;br&gt;mask các cột pad (j ≥ S)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1520" y="560" width="200" height="90" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;DEMUX đích&lt;/b&gt;&lt;br&gt;Q_h / K_h / V_hᵀ /&lt;br&gt;Concat[:, h] / X_buf (Out)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1520" y="430" width="200" height="90" as="geometry"/></mxCell><mxCell id="c24" value="X (1 lần / layer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#6c8ebf;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="W: mỗi lát cột đọc đúng 1 lần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;fontColor=#d6b656;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="bias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#6c8ebf;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontColor=#9673a6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="start / cfg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontColor=#9673a6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="C int32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="S = q·Kᵀ (int32)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c20" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="P int8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c22" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="int8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;" edge="1" parent="1" source="c23" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;" edge="1" parent="1" source="c23" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;" edge="1" parent="1" source="c23" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="O_h" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#6c8ebf;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="c23" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="Out (ghi tại chỗ vào X_buf, rồi xuất)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#6c8ebf;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.1;dashed=1;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="30" height="20" as="geometry"/></mxCell><mxCell id="c49" value="sống cả layer (S × D)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="55" y="718" width="300" height="25" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="30" height="20" as="geometry"/></mxCell><mxCell id="c51" value="sống 1 head (đổi khi sang head mới)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="55" y="748" width="300" height="25" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="30" height="20" as="geometry"/></mxCell><mxCell id="c53" value="sống 1 khối hàng TILE (ping-pong)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="55" y="778" width="300" height="25" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b style=&quot;font-size:15px&quot;&gt;Vì sao khung này ít data movement&lt;/b&gt;&lt;br&gt;
1. &lt;b&gt;X đọc 1 lần&lt;/b&gt; vào X_buf, mọi head đọc lại X từ BRAM chứ không lên DDR.&lt;br&gt;
2. &lt;b&gt;Mỗi trọng số đọc đúng 1 lần / layer&lt;/b&gt;: B_Bram giữ 1 lát cột W (D × TILE), quét hết S hàng của X rồi mới đổi lát (đúng vòng cp_K → cp_M → cp_N của core hiện tại). Lát kế tiếp nạp vào bank pong trong lúc tính bank ping.&lt;br&gt;
3. &lt;b&gt;K_h, V_hᵀ, Q_h không bao giờ ra DDR&lt;/b&gt;: S × d_h rất nhỏ (32 KB / ma trận khi S=512).&lt;br&gt;
4. &lt;b&gt;Ma trận S × S không bao giờ tồn tại&lt;/b&gt;: attention làm theo khối TILE hàng, chỉ cần TILE × S score. Đây là ý chính của flash-attention; với VC707 thì giữ nguyên hàng score rồi softmax thường là đủ, chưa cần online softmax.&lt;br&gt;
5. &lt;b&gt;Bias không tốn pass riêng&lt;/b&gt;: nạp bias làm giá trị đầu của acc. &lt;b&gt;1/√d_h&lt;/b&gt; gộp vào scale_q, không cần mạch chia.&lt;br&gt;
6. &lt;b&gt;Tái sử dụng nhiều layer&lt;/b&gt;: Out = X + Concat·Wo ghi đè tại chỗ vào X_buf (mỗi phần tử đọc X rồi ghi Out đúng 1 lần nên an toàn) → X_buf chính là input layer sau. Chỉ cần đổi base_W trong CSR rồi START lại.&lt;br&gt;
DDR mỗi layer ≈ 4·D² (W) + 2·S·D (X vào, Out ra) + 12 KB bias. Với S=512: ≈ 3.0 MiB, trong đó 2.25 MiB là W (ước lượng)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="250" y="720" width="1450" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Lịch tính 1 lớp" id="959108623426377899"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:20px&quot;&gt;Lịch tính 1 lớp: GEMM nào lấy A, B ở đâu (không cần mạch transpose)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Quy tắc từ waveform của core: &lt;b&gt;A đọc theo hàng&lt;/b&gt; (local_a = R0..R(TILE-1)), &lt;b&gt;B đọc theo cột&lt;/b&gt; (local_b = C0..C(TILE-1)). Vậy chỉ cần: A lưu row-major, B lưu sao cho 1 cột B nằm liền nhau. Nếu core thật ra đọc ngược lại thì chỉ cần đổi vai A/B." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;table border=&quot;1&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:13px&quot;&gt;
&lt;tr style=&quot;background:#e1d5e7&quot;&gt;&lt;th&gt;Bước&lt;/th&gt;&lt;th&gt;Phép tính&lt;/th&gt;&lt;th&gt;A (theo hàng)&lt;/th&gt;&lt;th&gt;B (theo cột)&lt;/th&gt;&lt;th&gt;Kết quả → đâu&lt;/th&gt;&lt;th&gt;Lặp&lt;/th&gt;&lt;th&gt;Mẹo&lt;/th&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;LOAD_X&lt;/td&gt;&lt;td colspan=&quot;3&quot;&gt;DDR → X_buf (S × D)&lt;/td&gt;&lt;td&gt;1 lần / layer&lt;/td&gt;&lt;td&gt;Pad S lên bội TILE&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;K_h = X·Wk_h + bk&lt;/td&gt;&lt;td&gt;X_buf&lt;/td&gt;&lt;td&gt;W_tile = lát cột Wk_h&lt;br&gt;(host lưu Wkᵀ sẵn)&lt;/td&gt;&lt;td&gt;K_h (row-major)&lt;/td&gt;&lt;td&gt;mỗi head&lt;/td&gt;&lt;td&gt;K row-major chính là “cột của Kᵀ”&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;V_hᵀ = Wv_hᵀ·Xᵀ + bv&lt;/td&gt;&lt;td&gt;W_tile = Wv_hᵀ&lt;br&gt;(host lưu sẵn)&lt;/td&gt;&lt;td&gt;X_buf&lt;br&gt;(cột của Xᵀ = hàng X)&lt;/td&gt;&lt;td&gt;V_hᵀ (row-major)&lt;/td&gt;&lt;td&gt;mỗi head&lt;/td&gt;&lt;td&gt;Đảo vai A/B để ra Vᵀ, khỏi transpose&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Q_h = X·Wq_h + bq&lt;/td&gt;&lt;td&gt;X_buf&lt;/td&gt;&lt;td&gt;W_tile = lát cột Wq_h&lt;/td&gt;&lt;td&gt;Q_h&lt;/td&gt;&lt;td&gt;mỗi head&lt;/td&gt;&lt;td&gt;scale_q gộp 1/√d_h&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;4a&lt;/td&gt;&lt;td&gt;s_i = q_i·K_hᵀ&lt;/td&gt;&lt;td&gt;Q_h hàng i..i+TILE&lt;/td&gt;&lt;td&gt;K_h (hàng j của K = cột j của Kᵀ)&lt;/td&gt;&lt;td&gt;Score[ping] int32&lt;/td&gt;&lt;td&gt;mỗi khối hàng i&lt;/td&gt;&lt;td&gt;Giữ int32 cho softmax&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;4b&lt;/td&gt;&lt;td&gt;P_i = softmax(s_i)&lt;/td&gt;&lt;td colspan=&quot;2&quot;&gt;Softmax unit đọc Score[ping]&lt;/td&gt;&lt;td&gt;P_buf int8&lt;/td&gt;&lt;td&gt;mỗi khối i&lt;/td&gt;&lt;td&gt;Chạy song song với 4a của khối i+1 (Score[pong])&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;4c&lt;/td&gt;&lt;td&gt;o_i = P_i·V_h&lt;/td&gt;&lt;td&gt;P_buf&lt;/td&gt;&lt;td&gt;V_hᵀ (hàng của Vᵀ = cột của V)&lt;/td&gt;&lt;td&gt;Concat[i, h·d_h ..]&lt;/td&gt;&lt;td&gt;mỗi khối i&lt;/td&gt;&lt;td&gt;Requant với scale_p·scale_v&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#dae8fc&quot;&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;Out = X + Concat·Wo + bo&lt;/td&gt;&lt;td&gt;Concat_buf&lt;/td&gt;&lt;td&gt;W_tile = lát cột Wo&lt;/td&gt;&lt;td&gt;ghi tại chỗ X_buf&lt;/td&gt;&lt;td&gt;1 lần / layer&lt;/td&gt;&lt;td&gt;Residual cộng ở bước requant&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;STORE / layer sau&lt;/td&gt;&lt;td colspan=&quot;3&quot;&gt;X_buf → DDR, hoặc giữ nguyên làm X của layer sau&lt;/td&gt;&lt;td&gt;1 lần&lt;/td&gt;&lt;td&gt;LayerNorm: khối riêng, làm sau&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1700" height="520" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:15px&quot;&gt;Thứ tự vòng lặp cho mỗi phép chiếu (bước 1, 2, 3, 5): weight-stationary ở BRAM, output-stationary ở thanh ghi&lt;/b&gt;&lt;br&gt;
&lt;pre style=&quot;font-size:13px&quot;&gt;for j in cột_tile(W):            // cp_N : nạp 1 lát W (D × TILE) vào B_Bram — đọc DDR đúng 1 lần, lát j+1 nạp vào bank pong
  for i in hàng_tile(X):         // cp_M : quét hết S/TILE khối hàng của X (từ X_buf, không lên DDR)
    for k in 0..D/TILE-1:        // cp_K : cộng dồn trong acc (k=0 nạp bias, k&amp;gt;0 là PL)
      C[i][j] += A[i][k] · B[k][j]
    requant → ghi C[i][j] vào đích&lt;/pre&gt;
&lt;b&gt;Cấu hình head tuỳ ý:&lt;/b&gt; d_h = 768 / H phải chia hết cho TILE. Với TILE = 16: H ∈ {1, 2, 3, 4, 6, 8, 12, 16, 24, 48}. Các bộ đếm i, j, k lấy giới hạn từ CSR (S, d_h) nên đổi cấu hình không cần synth lại; chỉ BRAM được cấp theo S_max lúc synth.&lt;br&gt;
&lt;b&gt;S tuỳ ý:&lt;/b&gt; pad lên bội TILE. Cột pad trong score phải ép về −∞ (hoặc giá trị nhỏ nhất) trước softmax, &lt;b&gt;không phải 0&lt;/b&gt;, nếu không xác suất bị chia cho cả cột rác." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1700" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Timing 1 head" id="5792403615285170145"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:20px&quot;&gt;Timing 1 head (không theo tỉ lệ, minh hoạ chồng lấp)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Cổng bộ nhớ (nạp W)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="200" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;GEMM core&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="200" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Softmax unit&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="200" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Requant / ghi đích&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="200" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Wk_h lát 0..3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="85" width="120" height="50" as="geometry"/></mxCell><mxCell id="c9" value="Wv_hᵀ lát" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="85" width="120" height="50" as="geometry"/></mxCell><mxCell id="c10" value="Wq_h lát" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="85" width="120" height="50" as="geometry"/></mxCell><mxCell id="c11" value="Wk_(h+1) cho head sau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="85" width="180" height="50" as="geometry"/></mxCell><mxCell id="c12" value="PROJ_K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="175" width="120" height="50" as="geometry"/></mxCell><mxCell id="c13" value="PROJ_V (ra Vᵀ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="175" width="120" height="50" as="geometry"/></mxCell><mxCell id="c14" value="PROJ_Q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="175" width="120" height="50" as="geometry"/></mxCell><mxCell id="c15" value="s_0=q·Kᵀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="175" width="60" height="50" as="geometry"/></mxCell><mxCell id="c16" value="s_1=q·Kᵀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="175" width="60" height="50" as="geometry"/></mxCell><mxCell id="c17" value="o_0=P·V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="175" width="60" height="50" as="geometry"/></mxCell><mxCell id="c18" value="s_2=q·Kᵀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="175" width="60" height="50" as="geometry"/></mxCell><mxCell id="c19" value="o_1=P·V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="175" width="60" height="50" as="geometry"/></mxCell><mxCell id="c20" value="s_3=q·Kᵀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="175" width="60" height="50" as="geometry"/></mxCell><mxCell id="c21" value="o_2=P·V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="175" width="60" height="50" as="geometry"/></mxCell><mxCell id="c22" value="o_3=P·V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="175" width="60" height="50" as="geometry"/></mxCell><mxCell id="c23" value="softmax 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="265" width="60" height="50" as="geometry"/></mxCell><mxCell id="c24" value="softmax 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="265" width="60" height="50" as="geometry"/></mxCell><mxCell id="c25" value="softmax 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="265" width="60" height="50" as="geometry"/></mxCell><mxCell id="c26" value="softmax 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="265" width="60" height="50" as="geometry"/></mxCell><mxCell id="c27" value="ghi K_h, V_hᵀ, Q_h (sau mỗi tile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="355" width="360" height="50" as="geometry"/></mxCell><mxCell id="c28" value="ghi o_i vào Concat[:, h] (int8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="355" width="600" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Đọc hình:&lt;/b&gt;&lt;br&gt;
• Pha chiếu (PROJ_K/V/Q): lát W kế tiếp được nạp vào bank pong trong lúc GEMM tính bank ping → bộ nhớ ngoài bị che hoàn toàn nếu thời gian tính 1 lát ≥ thời gian nạp 1 lát.&lt;br&gt;
&amp;nbsp;&amp;nbsp;Ước lượng: 1 lát = D·TILE = 12 KB; tính 1 lát = S·D·TILE MAC. Với S=512 thì cần ~6.3 M MAC cho 12 KB → luôn là compute-bound (giả định cổng 32-bit @ 200 MHz).&lt;br&gt;
• Pha attention: GEMM xen kẽ s_i (khối i) và o_(i−1) (khối trước) trong lúc softmax xử lý khối i trên Score[ping]. Cần Score ping/pong để GEMM không phải chờ softmax.&lt;br&gt;
• Head sau bắt đầu nạp Wk_(h+1) ngay khi head này vào pha attention (bộ nhớ đang rảnh).&lt;br&gt;
• Sau head cuối: PROJ_O quét Concat × Wo giống pha chiếu, ghi Out tại chỗ vào X_buf.&lt;br&gt;&lt;br&gt;
&lt;b&gt;Số MAC 1 layer (S=512, D=768):&lt;/b&gt; chiếu 4·S·D² ≈ 1.21 G MAC, attention 2·S²·D ≈ 0.40 G MAC. Thời gian thật phụ thuộc số MAC/chu kỳ của core (chưa biết)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="240" y="450" width="1500" height="320" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. BRAM + so sánh" id="6746999736676799311"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:20px&quot;&gt;Công thức BRAM và so sánh lượng data movement (ước lượng)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;BRAM cho khung đề xuất (B):&lt;/b&gt;&lt;br&gt;
&lt;pre style=&quot;font-size:13px&quot;&gt;BRAM ≈ 2·S·D            (X_buf + Concat_buf)
     + 3·S·d_h          (Q_h, K_h, V_hᵀ)
     + 2·TILE·S·4       (Score ping/pong, int32)
     + TILE·S           (P_buf)
     + 2·D·TILE         (W_tile ping/pong = B_Bram)
     + 16·D             (bias int32)&lt;/pre&gt;
VC707 (XC7VX485T): 1030 BRAM36 ≈ 4.0 MiB khi dùng 8-bit (bỏ bit parity). Mỗi buffer còn bị làm tròn lên theo khối BRAM và độ rộng cổng, nên số thật sẽ cao hơn chút." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="1700" height="200" as="geometry"/></mxCell><mxCell id="c5" value="&lt;table border=&quot;1&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:13px&quot;&gt;
&lt;tr style=&quot;background:#e1d5e7&quot;&gt;&lt;th&gt;Phương án&lt;/th&gt;&lt;th&gt;Ý tưởng&lt;/th&gt;&lt;th&gt;DDR / layer (S=512, H=12)&lt;/th&gt;&lt;th&gt;BRAM (S=512)&lt;/th&gt;&lt;th&gt;S tối đa (H=12)&lt;/th&gt;&lt;th&gt;Nhận xét&lt;/th&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;A. Naive&lt;/td&gt;&lt;td&gt;Q, K, V, score S×S đều ra DDR&lt;/td&gt;&lt;td&gt;≈ 36.8 MiB&lt;br&gt;4D² + 12SD + 10HS²&lt;/td&gt;&lt;td&gt;≈ 0.06 MiB&lt;/td&gt;&lt;td&gt;không giới hạn&lt;/td&gt;&lt;td&gt;Tăng theo S², không dùng&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;A2. QKV qua DDR&lt;/td&gt;&lt;td&gt;Score ở on-chip, nhưng Q/K/V/Concat ghi ra rồi đọc lại&lt;/td&gt;&lt;td&gt;≈ 6.0 MiB&lt;br&gt;4D² + 10SD&lt;/td&gt;&lt;td&gt;≈ 0.11 MiB&lt;/td&gt;&lt;td&gt;không giới hạn&lt;/td&gt;&lt;td&gt;Dự phòng cho S rất lớn&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#d5e8d4&quot;&gt;&lt;td&gt;&lt;b&gt;B. Đề xuất&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Head-serial, X + Concat nằm trong BRAM, attention theo khối hàng&lt;/td&gt;&lt;td&gt;&lt;b&gt;≈ 3.0 MiB&lt;/b&gt;&lt;br&gt;4D² + 2SD&lt;/td&gt;&lt;td&gt;≈ 0.95 MiB&lt;/td&gt;&lt;td&gt;≈ 2190&lt;/td&gt;&lt;td&gt;Mỗi byte vào / ra đúng 1 lần. Ít logic&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;C. W thường trú&lt;/td&gt;&lt;td&gt;Như B, nhưng cả 4 W (2.25 MiB) nằm luôn trong BRAM&lt;/td&gt;&lt;td&gt;≈ 0.75 MiB / lần chạy&lt;br&gt;(nạp W 1 lần đầu)&lt;/td&gt;&lt;td&gt;≈ 3.2 MiB&lt;/td&gt;&lt;td&gt;≈ 940&lt;/td&gt;&lt;td&gt;Tốt khi chạy cùng 1 layer nhiều lần; nhiều layer khác W thì không lợi&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;D. Fused theo hàng&lt;/td&gt;&lt;td&gt;K, V mọi head trong BRAM; mỗi khối hàng chạy hết các head rồi ra Out luôn&lt;/td&gt;&lt;td&gt;≈ 3.0 MiB&lt;/td&gt;&lt;td&gt;≈ 2.4 MiB&lt;/td&gt;&lt;td&gt;≈ 1150&lt;/td&gt;&lt;td&gt;Bằng DDR của B nhưng tốn BRAM gấp 2.5, cần Wq + Wo thường trú&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;E. B + online softmax&lt;/td&gt;&lt;td&gt;Flash-attention thật: score chỉ TILE×TILE, rescale acc theo max mới&lt;/td&gt;&lt;td&gt;≈ 3.0 MiB&lt;/td&gt;&lt;td&gt;≈ 0.89 MiB&lt;/td&gt;&lt;td&gt;≈ 2350&lt;/td&gt;&lt;td&gt;Tiết kiệm ít, thêm mạch exp + nhân rescale. Để dành v2&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1700" height="380" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Khi đổi số head (S=512, phương án B):&lt;/b&gt; H=1 → 1.98 MiB, H=4 → 1.14 MiB, H=12 → 0.95 MiB, H=24 → 0.91 MiB. S tối đa: H=1 ≈ 1020, H=4 ≈ 1800, H=12 ≈ 2190.&lt;br&gt;&lt;br&gt;
&lt;b&gt;Kết luận:&lt;/b&gt; chọn B làm khung chính. Lượng DDR của B là mức tối thiểu khi W phải đọc từ ngoài (không có cách nào đọc W ít hơn 1 lần mỗi layer). C chỉ đáng khi bồ chạy đi chạy lại đúng 1 bộ W (ví dụ demo nạp W qua UART 1 lần). A2 là đường lui nếu sau này S vượt ~2000.&lt;br&gt;&lt;br&gt;
&lt;b&gt;Giả định cần xác nhận:&lt;/b&gt; TILE = 16; core đọc A theo hàng, B theo cột; acc int32; DDR cổng 32-bit @ 200 MHz. Mọi con số là ước lượng tính tay, chưa synth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;arcSize=6;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1700" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>