meter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36393d;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="420" width="40" height="40" as="geometry"/></mxCell><mxCell id="n67" value="bias_out (768)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#36393d;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="426" width="100" height="28" as="geometry"/></mxCell><mxCell id="n68" value="" style="shape=orEllipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36393d;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="210" width="40" height="40" as="geometry"/></mxCell><mxCell id="n69" value="Out&#xa;S × 768" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFD9A0;strokeColor=#36393d;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1680" y="200" width="120" height="60" as="geometry"/></mxCell><mxCell id="n70" value="LayerNorm&#xa;(ngoài khối MHSA)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1840" y="200" width="120" height="60" as="geometry"/></mxCell><mxCell id="e71" value="S×768" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n62" target="n64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n65" target="n64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e73" value="S×768" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n64" target="n66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n67" target="n66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e75" value="S×768" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n66" target="n68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n68" target="n69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e77" value="Residual: X (S×768)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n68"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="95"/><mxPoint x="1600" y="95"/></Array></mxGeometry></mxCell><mxCell id="e78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n69" target="n70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n79" value="Công thức (h = 0 … 11):&#xa;  Q = X·W_Q + b_Q,   K = X·W_K + b_K,   V = X·W_V + b_V            (S×768)&#xa;  Q_h, K_h, V_h = cột 64h … 64h+63 của Q, K, V                        (S×64)&#xa;  Score_h = Q_h·K_hᵀ / √64   →   P_h = softmax_hàng(Score_h)          (S×S)&#xa;  O_h = P_h·V_h   (S×64);   Concat = [O_0 | O_1 | … | O_11]           (S×768)&#xa;  Out = X + Concat·W_O + b_out                                         (S×768)&#xa;&#xa;Ghi chú: ⊗ = nhân ma trận, ⊕ = cộng. Self-attention hai chiều (không mask). Ranh giới khối: LayerNorm đặt ngoài MHSA (đề xuất, chờ Long xác nhận)." style="text;whiteSpace=wrap;html=0;fontSize=12;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1500" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Zoom 1 head"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n80" value="Bên trong 1 head (h cố định): từ Q_h, K_h, V_h (S×64) ra O_h (S×64)" style="text;whiteSpace=wrap;html=0;fontSize=18;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="n81" value="Q_h&#xa;S × 64" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFF9C4;strokeColor=#36393d;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="120" height="60" as="geometry"/></mxCell><mxCell id="n82" value="K_h&#xa;S × 64" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#D6E8FF;strokeColor=#36393d;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="120" height="60" as="geometry"/></mxCell><mxCell id="n83" value="V_h&#xa;S × 64" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#F5F1DC;strokeColor=#36393d;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="120" height="60" as="geometry"/></mxCell><mxCell id="n84" value="① Điểm tương đồng&#xa;Score[i][j] = ( Σ_{d=0..63} Q_h[i][d]·K_h[j][d] ) / 8&#xa;(√64 = 8)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#C9F2C9;strokeColor=#36393d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="170" width="300" height="120" as="geometry"/></mxCell><mxCell id="n85" value="② Softmax theo hàng i&#xa;m_i = max_j Score[i][j]&#xa;P[i][j] = e^(Score[i][j] − m_i) / Σ_j e^(Score[i][j] − m_i)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#36393d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="300" height="120" as="geometry"/></mxCell><mxCell id="n86" value="③ Trộn V theo trọng số&#xa;O_h[i][d] = Σ_{j=0..S−1} P[i][j]·V_h[j][d]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#E3E0FF;strokeColor=#36393d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="300" height="120" as="geometry"/></mxCell><mxCell id="n87" value="O_h&#xa;S × 64" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#E3E0FF;strokeColor=#36393d;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="120" height="60" as="geometry"/></mxCell><mxCell id="n88" value="Concat: cột 64h … 64h+63&#xa;(S × 768)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#E3E0FF;strokeColor=#36393d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="500" width="180" height="60" as="geometry"/></mxCell><mxCell id="e89" value="hàng i" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n81" target="n84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e90" value="hàng j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n82" target="n84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e91" value="S×S" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n84" target="n85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e92" value="P  S×S" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n85" target="n86"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e93" value="S×64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n83" target="n86"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n86" target="n87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e95" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#36393d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n87" target="n88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n96" value="Kᵀ chỉ là cách đọc chỉ số: Score[i][j] = tích vô hướng hàng i của Q_h với hàng j của K_h. Không cần mạch chuyển vị thật nếu đọc K theo hàng." style="text;whiteSpace=wrap;html=0;fontSize=11;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="260" y="320" width="320" height="110" as="geometry"/></mxCell><mxCell id="n97" value="Trừ max m_i trước khi lấy e^x để không tràn số; kết quả giống hệt softmax gốc. Mỗi hàng P[i][·] là phân bố xác suất (tổng = 1): token i “chú ý” bao nhiêu vào token j." style="text;whiteSpace=wrap;html=0;fontSize=11;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="340" height="120" as="geometry"/></mxCell><mxCell id="n98" value="Khối lượng tính (số phép nhân-cộng, MAC) cho cả layer:&#xa;  Chiếu Q, K, V, O: 4 · S · 768 · 768 = 2 359 296 · S&#xa;  Attention 12 head: 12 · (S·S·64 [QKᵀ] + S·S·64 [PV]) = 1 536 · S²&#xa;  Ví dụ S = 128: ≈ 302 M + 25 M MAC;  S = 512: ≈ 1.21 G + 0.40 G MAC&#xa;  Bộ nhớ trung gian lớn nhất mỗi head: Score/P kích thước S×S." style="text;whiteSpace=wrap;html=0;fontSize=12;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1400" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>