          <mxGeometry as="geometry" x="40.0" y="1019" width="852.96875" height="25" />
        </mxCell>
        <mxCell id="addLatency" value="Operands accepted at edge k produce a result after k+5. Row accumulation issues an addition every eight cycles." vertex="1" parent="1" style="text;html=0;align=left;spacing=0;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#172d40;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="40.0" y="1052" width="857.0" height="22" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fsm" name="Top-level state machine">
    <mxGraphModel page="1" pageWidth="900" pageHeight="1080" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b0" vertex="1" parent="1" value="&lt;div style=&quot;font-size:21px;color:#172d40;font-weight:bold;&quot;&gt;IDLE&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#475e70;font-weight:normal;&quot;&gt;Wait for start while the front end is ready.&lt;/div&gt;" style="rounded=1;html=1;fontFamily=Arial;align=left;spacingLeft=14;fillColor=#f1f6f9;strokeColor=#99adba;">
          <mxGeometry as="geometry" x="230.0" y="125.0" width="440.0" height="73.0" />
        </mxCell>
        <mxCell id="b1" vertex="1" parent="1" value="&lt;div style=&quot;font-size:21px;color:#172d40;font-weight:bold;&quot;&gt;WAIT_SUM&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#475e70;font-weight:normal;&quot;&gt;On sum_valid, capture sum_fp32 in sum_reg.&lt;/div&gt;" style="rounded=1;html=1;fontFamily=Arial;align=left;spacingLeft=14;fillColor=#f1f6f9;strokeColor=#99adba;">
          <mxGeometry as="geometry" x="230.0" y="263.0" width="440.0" height="73.0" />
        </mxCell>
        <mxCell id="b2" vertex="1" parent="1" value="&lt;div style=&quot;font-size:21px;color:#172d40;font-weight:bold;&quot;&gt;READ_NUMERATOR&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#475e70;font-weight:normal;&quot;&gt;Read exp_buffer[div_index] on the next rising edge.&lt;/div&gt;" style="rounded=1;html=1;fontFamily=Arial;align=left;spacingLeft=14;fillColor=#e7f5f0;strokeColor=#096762;">
          <mxGeometry as="geometry" x="230.0" y="401.0" width="440.0" height="73.0" />
        </mxCell>
        <mxCell id="b3" vertex="1" parent="1" value="&lt;div style=&quot;font-size:21px;color:#172d40;font-weight:bold;&quot;&gt;DIV_REQUEST&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#475e70;font-weight:normal;&quot;&gt;Hold div_in_valid high until the divider accepts.&lt;/div&gt;" style="rounded=1;html=1;fontFamily=Arial;align=left;spacingLeft=14;fillColor=#f1f6f9;strokeColor=#99adba;">
          <mxGeometry as="geometry" x="230.0" y="539.0" width="440.0" height="73.0" />
        </mxCell>
        <mxCell id="b4" vertex="1" parent="1" value="&lt;div style=&quot;font-size:21px;color:#172d40;font-weight:bold;&quot;&gt;DIV_WAIT&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#475e70;font-weight:normal;&quot;&gt;Capture the FP32 result, valid and last tag.&lt;/div&gt;" style="rounded=1;html=1;fontFamily=Arial;align=left;spacingLeft=14;fillColor=#f1f6f9;strokeColor=#99adba;">
          <mxGeometry as="geometry" x="230.0" y="677.0" width="440.0" height="73.0" />
        </mxCell>
        <mxCell id="b5" vertex="1" parent="1" value="&lt;div style=&quot;font-size:21px;color:#172d40;font-weight:bold;&quot;&gt;QUANTIZE_WAIT&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#475e70;font-weight:normal;&quot;&gt;Wait for the last tag in the three-stage quantizer.&lt;/div&gt;" style="rounded=1;html=1;fontFamily=Arial;align=left;spacingLeft=14;fillColor=#f1f6f9;strokeColor=#99adba;">
          <mxGeometry as="geometry" x="230.0" y="815.0" width="440.0" height="73.0" />
        </mxCell>
        <mxCell id="b6" vertex="1" parent="1" value="&lt;div style=&quot;font-size:21px;color:#172d40;font-weight:bold;&quot;&gt;COMPLETE&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#475e70;font-weight:normal;&quot;&gt;out_valid = out_last = done = 1; ready = 0.&lt;/div&gt;" style="rounded=1;html=1;fontFamily=Arial;align=left;spacingLeft=14;fillColor=#f1f6f9;strokeColor=#99adba;">
          <mxGeometry as="geometry" x="230.0" y="953.0" width="440.0" height="73.0" />
        </mxCell>
        <mxCell id="t0" vertex="1" parent="1" value="Softmax top-level state machine" style="text;html=0;spacing=0;fillColor=none;strokeColor=none;align=left;fontFamily=Arial;fontColor=#172d40;fontSize=32;fontStyle=1;">
          <mxGeometry as="geometry" x="40.0" y="23.0" width="548.0" height="37.0" />
        </mxCell>
