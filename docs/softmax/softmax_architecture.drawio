        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#344a60;exitX=0.0;exitY=0.8857142857142857;entryX=1.0;entryY=0.4;" edge="1" parent="1" source="sum" target="sumreg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#344a60;exitX=0.0;exitY=0.47058823529411764;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="cast" target="div">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#344a60;exitX=0.0;exitY=0.4;entryX=1.0;entryY=0.7391304347826086;" edge="1" parent="1" source="sumreg" target="div">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#344a60;exitX=0.0;exitY=0.391304347826087;entryX=1.0;entryY=0.391304347826087;" edge="1" parent="1" source="div" target="prob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#344a60;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="prob" target="quant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#344a60;exitX=1.0;exitY=0.4318181818181818;entryX=0.0;entryY=0.4318181818181818;" edge="1" parent="1" source="quant" target="output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;SOFTMAX — DATAPATH / INT32 → INT8&lt;/div&gt;Reference build: input scale = 1, MAX_LENGTH = 32, COUNT_WIDTH = 6&lt;br&gt;Blue: clocked logic | Green: combinational logic | Yellow: storage and sum | Purple: control" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#f5f7fa;strokeColor=#728092;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Matrix product input&lt;/div&gt;in_data[31:0] — signed INT32&lt;br&gt;in_valid[0] → / ← in_ready[0]&lt;br&gt;start[0], row_length[C−1:0]&lt;br&gt;One score per input handshake" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#e5f3f8;strokeColor=#24677b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="row" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;softmax_row_max&lt;/div&gt;IN: in_data[31:0] INT32&lt;br&gt;Store row and track maximum&lt;br&gt;OUT: diff_data[32:0] INT33&lt;br&gt;diff_valid[0], done[0]&lt;br&gt;max_value[31:0] INT32&lt;br&gt;Subtract max after row capture" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="180" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="convert" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;int33_to_bf16&lt;/div&gt;IN: in_data[32:0] INT33&lt;br&gt;Normalize and round (RNE)&lt;br&gt;OUT: out_bf16[15:0] BF16&lt;br&gt;Combinational logic" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#e8f7ef;strokeColor=#287556;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="860" y="200" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="vexp" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;VEXP in softmax_exp&lt;/div&gt;bf_q → exps_stage → exps_q&lt;br&gt;vexp_finish (px) → exp_data BF16&lt;br&gt;Two registered valid and last stages" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1270" y="200" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sum" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;softmax_sum + exp_buffer&lt;/div&gt;IN: exp_data[15:0] BF16&lt;br&gt;exp_valid[0], exp_last[0]&lt;br&gt;exp_buffer: 32 × 16 bit&lt;br&gt;Accumulate after row capture&lt;br&gt;BF16 → FP32 ({data,16&amp;#x27;b0})&lt;br&gt;fp32_add_positive: 6 stages&lt;br&gt;accumulator[31:0] FP32&lt;br&gt;OUT: sum_fp32[31:0], sum_valid[0]&lt;br&gt;READ: read_index[C−1:0] →&lt;br&gt;read_data[15:0] BF16 (sync read)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#fff3db;strokeColor=#996825;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1270" y="540" width="400" height="350" as="geometry" />
        </mxCell>
        <mxCell id="cast" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Numerator expansion&lt;/div&gt;read_data[15:0] BF16&lt;br&gt;→ {read_data,16&amp;#x27;b0}&lt;br&gt;div_numerator[31:0] FP32&lt;br&gt;read_index = div_index" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#e8f7ef;strokeColor=#287556;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="860" y="540" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sumreg" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;sum_reg in softmax&lt;/div&gt;Capture when sum_valid = 1&lt;br&gt;Hold the FP32 row sum&lt;br&gt;Shared denominator for the row" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="860" y="790" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="div" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;fp32_div_positive&lt;/div&gt;IN: numerator[31:0] FP32&lt;br&gt;denominator[31:0] FP32&lt;br&gt;in_valid[0] / in_ready[0]&lt;br&gt;OUT: result[31:0] FP32&lt;br&gt;out_valid[0]&lt;br&gt;Iterative binary division" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="680" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="prob" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Probability register&lt;/div&gt;In softmax.sv&lt;br&gt;probability_fp32[31:0]&lt;br&gt;probability_valid[0]&lt;br&gt;probability_last[0]&lt;br&gt;Capture the divider result" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="quant" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;fp32_to_int8&lt;/div&gt;IN: in_data[31:0] FP32&lt;br&gt;in_valid[0]&lt;br&gt;×127 → RNE FP32&lt;br&gt;→ RNE integer → clamp 0…127&lt;br&gt;OUT: out_data[7:0] signed INT8&lt;br&gt;out_valid[0], three-stage pipeline" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="output" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;OUTPUT / softmax.sv&lt;/div&gt;out_data[7:0] — signed INT8&lt;br&gt;Code range: 0 to 127&lt;br&gt;out_valid: result available&lt;br&gt;out_last: final result&lt;br&gt;done[0] = out_valid &amp;amp; out_last&lt;br&gt;Capture each valid output" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#e5f3f8;strokeColor=#24677b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="1040" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="control" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Top-level controller in softmax.sv&lt;/div&gt;IDLE → WAIT_SUM → READ_NUMERATOR → DIV_REQUEST → DIV_WAIT&lt;br&gt;More elements: return to READ_NUMERATOR. Final element: QUANTIZE_WAIT → COMPLETE.&lt;br&gt;read_index selects the numerator. sum_reg holds the denominator throughout division.&lt;br&gt;The last tag follows the INT8 pipeline. done marks the final valid result.&lt;br&gt;ready stays low until the row completes.&lt;br&gt;S = 32: routed WNS = −0.061 ns at a 5 ns target." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="860" y="1030" width="810" height="240" as="geometry" />
        </mxCell>
        <mxCell id="validnote" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Stream control&lt;/div&gt;diff_valid and row_last follow the data through both VEXP stages.&lt;br&gt;softmax_exp.done marks the final exponential. Top-level done marks the final INT8." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#f5f7fa;strokeColor=#728092;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="435" width="710" height="100" as="geometry" />
        </mxCell>
        <mxCell id="label0" value="32 bit" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="355" y="255" width="51.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="33 bit" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="770" y="255" width="51.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="16 bit" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1180" y="255" width="51.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label3" value="exp_data[15:0] BF16" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1490" y="445" width="160.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label4" value="exp_valid / exp_last: 1 bit" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1490" y="472" width="191.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label5" value="16 bit" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1175" y="585" width="51.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label6" value="32 bit" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1180" y="825" width="51.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label7" value="FP32 numerator" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="650" y="590" width="127.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label8" value="Denom." style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="770" y="815" width="68.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label9" value="32 bit" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="355" y="740" width="51.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label10" value="FP32 / 32 bit + valid" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="210" y="965" width="153.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label11" value="8 bit" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="365" y="1105" width="42.0" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="softmax_02_interfaces" name="02 Interfaces">
    <mxGraphModel dx="1740" dy="1430" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1430" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Module interfaces&lt;/div&gt;Reference build: C = COUNT_WIDTH = 6. Each control signal is one bit.&lt;br&gt;Signal notation: name[W] denotes a bus of W bits." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#f5f7fa;strokeColor=#728092;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="card0" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;softmax&lt;/div&gt;IN: clk, rst_n, start; row_length[C]&lt;br&gt;in_data[32] INT32; in_valid&lt;br&gt;OUT: ready; in_ready&lt;br&gt;out_data[8] signed INT8 (0…127)&lt;br&gt;out_valid; out_last; done&lt;br&gt;Top FSM, front end, divider and quantizer" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="155" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card1" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;softmax_exp_sum&lt;/div&gt;IN: clk, rst_n, start; row_length[C]&lt;br&gt;in_data[32] INT32; in_valid&lt;br&gt;read_index[C]&lt;br&gt;OUT: ready; in_ready; sum_valid&lt;br&gt;sum_fp32[32] FP32; read_data[16] BF16&lt;br&gt;Exponential and sum wrapper" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="155" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card2" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;softmax_exp&lt;/div&gt;IN: clk, rst_n, start; row_length[C]&lt;br&gt;in_data[32] INT32; in_valid&lt;br&gt;OUT: in_ready; done; exp_valid&lt;br&gt;max_value[32] INT32&lt;br&gt;exp_data[16] BF16&lt;br&gt;Row maximum, conversion and exponential pipeline" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1160" y="155" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card3" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;softmax_row_max&lt;/div&gt;IN: clk, rst_n, start; row_length[C]&lt;br&gt;in_data[32] INT32; in_valid&lt;br&gt;OUT: in_ready; done; diff_valid&lt;br&gt;max_value[32] INT32&lt;br&gt;diff_data[33] INT33&lt;br&gt;row_buffer[32][32]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="465" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card4" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;int33_to_bf16&lt;/div&gt;IN: in_data[33] signed INT33&lt;br&gt;OUT: out_bf16[16] BF16&lt;br&gt;BF16: sign 1 | exponent 8 | fraction 7&lt;br&gt;RNE: nearest, ties to even&lt;br&gt;Combinational datapath&lt;br&gt;Valid supplied by the wrapper" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#e8f7ef;strokeColor=#287556;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="465" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card5" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;vexp&lt;/div&gt;IN: x_in[16] BF16&lt;br&gt;OUT: exp_out[16] BF16&lt;br&gt;exps_stage: 16-bit intermediate and three flags&lt;br&gt;px: exps_in[7] → p_out[7]&lt;br&gt;Approximate exponential with underflow to zero&lt;br&gt;Standalone combinational VEXP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#e8f7ef;strokeColor=#287556;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1160" y="465" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card6" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;softmax_sum&lt;/div&gt;IN: clk, rst_n, start; row_length[C]&lt;br&gt;exp_data[16] BF16; exp_valid; exp_last&lt;br&gt;read_index[C]&lt;br&gt;OUT: ready; sum_valid&lt;br&gt;sum_fp32[32] FP32; read_data[16] BF16&lt;br&gt;exp_buffer[32][16] and FP32 adder" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#fff3db;strokeColor=#996825;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="775" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card7" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;fp32_add_positive&lt;/div&gt;IN: clk, rst_n; in_valid&lt;br&gt;a[32] FP32; b[32] FP32&lt;br&gt;OUT: in_ready; out_valid&lt;br&gt;result[32] FP32&lt;br&gt;Nonnegative FP32 addition with RNE&lt;br&gt;6 stages: accept at k, output after edge k+5" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="775" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card8" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;fp32_div_positive&lt;/div&gt;IN: clk, rst_n; in_valid&lt;br&gt;numerator[32] FP32&lt;br&gt;denominator[32] FP32&lt;br&gt;OUT: in_ready; out_valid; result[32] FP32&lt;br&gt;Iterative division: 26 quotient bits plus sticky&lt;br&gt;Normal result 31 cycles after acceptance" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1160" y="775" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card9" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;fp32_to_int8&lt;/div&gt;IN: clk, rst_n; in_valid&lt;br&gt;in_data[32] FP32&lt;br&gt;OUT: out_data[8] signed INT8; out_valid&lt;br&gt;FP32_RNE(p×127) → integer_RNE&lt;br&gt;Clamp to [0, 127] in a three-stage pipeline&lt;br&gt;Accept one input per valid cycle" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#eaf2ff;strokeColor=#315d98;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1085" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card10" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Completion signals&lt;/div&gt;softmax_exp.done marks the last exponential&lt;br&gt;Drives softmax_sum.exp_last&lt;br&gt;softmax_sum.sum_valid marks the final FP32 sum&lt;br&gt;out_valid and out_last mark the final INT8&lt;br&gt;softmax.done = out_valid &amp;amp;&amp;amp; out_last&lt;br&gt;done pulses once per completed output row" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="1085" width="530" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card11" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Numeric formats and memory&lt;/div&gt;Scores: signed INT32. Differences: signed INT33.&lt;br&gt;BF16: 16 bit; FP32: 32 bit&lt;br&gt;BF16→FP32: {value,16&amp;#x27;b0}, chính xác&lt;br&gt;read_index: C bits, synchronous read&lt;br&gt;Hold the row in exp_buffer until division completes&lt;br&gt;See the utilization report for physical BRAM usage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#728092;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1085" width="530" height="280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="softmax_03_control" name="03 Hierarchy and control">
    <mxGraphModel dx="1740" dy="1230" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1230" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="edge0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#7551a1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="idle" target="wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#7551a1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="wait" target="read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#7551a1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="read" target="request">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#7551a1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="request" target="waitdiv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#7551a1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="waitdiv" target="quantwait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#7551a1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="quantwait" target="complete">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#7551a1;exitX=0.0;exitY=0.5181818181818182;entryX=0.0;entryY=0.4939759036144578;" edge="1" parent="1" source="waitdiv" target="read">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="735" />
              <mxPoint x="900" y="462" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#7551a1;exitX=1.0;exitY=0.45454545454545453;entryX=1.0;entryY=0.5;" edge="1" parent="1" source="complete" target="idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1650" y="1050" />
              <mxPoint x="1650" y="215" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="title" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Module hierarchy and top-level FSM&lt;/div&gt;One active row at a time. Input scale = 1.&lt;br&gt;State transitions below describe the top-level softmax controller." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#f5f7fa;strokeColor=#728092;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="hier" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Instance hierarchy&lt;/div&gt;softmax.sv&lt;br&gt;  u_front : softmax_exp_sum&lt;br&gt;    u_exp : softmax_exp&lt;br&gt;      u_row : softmax_row_max&lt;br&gt;      u_convert : int33_to_bf16&lt;br&gt;      u_exps : exps_stage&lt;br&gt;      u_finish : vexp_finish → u_px : px&lt;br&gt;    u_sum : softmax_sum&lt;br&gt;      u_add : fp32_add_positive&lt;br&gt;  u_div : fp32_div_positive&lt;br&gt;  u_quantize : fp32_to_int8&lt;br&gt;The top holds sum_reg and probability_fp32." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#f5f7fa;strokeColor=#728092;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="760" height="510" as="geometry" />
        </mxCell>
        <mxCell id="protocol" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;Row protocol&lt;/div&gt;1. When ready is high, present start and a valid row_length.&lt;br&gt;2. Transfer one INT32 on each edge with in_valid and in_ready.&lt;br&gt;3. Subtract max, compute exponentials, sum and divide.&lt;br&gt;4. Each out_valid carries one INT8 in input order.&lt;br&gt;5. Final result: out_valid = out_last = done = 1.&lt;br&gt;6. ready returns high for the next row.&lt;br&gt;&lt;br&gt;The receiver must accept every valid output.&lt;br&gt;Setting rst_n low aborts the active row.&lt;br&gt;S = 32: routed WNS = −0.061 ns at 5 ns." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#e5f3f8;strokeColor=#24677b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="760" height="430" as="geometry" />
        </mxCell>
        <mxCell id="idle" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;IDLE&lt;/div&gt;Accept a valid start when the front end is ready." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="170" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wait" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;WAIT_SUM&lt;/div&gt;On sum_valid, capture sum_fp32 in sum_reg." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="300" width="520" height="82" as="geometry" />
        </mxCell>
        <mxCell id="read" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;READ_NUMERATOR&lt;/div&gt;Read the numerator at div_index synchronously." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="421" width="520" height="83" as="geometry" />
        </mxCell>
        <mxCell id="request" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;DIV_REQUEST&lt;/div&gt;Assert div_in_valid until div_in_ready." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="541" width="520" height="83" as="geometry" />
        </mxCell>
        <mxCell id="waitdiv" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;DIV_WAIT&lt;/div&gt;On div_out_valid, capture the quotient and last tag.&lt;br&gt;More elements: increment div_index and read again." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="678" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="quantwait" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;QUANTIZE_WAIT&lt;/div&gt;Wait for scaled_last = 1 in the INT8 pipeline." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="830" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="complete" value="&lt;div style=&quot;font-weight:bold;font-size:21px;margin-bottom:10px&quot;&gt;COMPLETE&lt;/div&gt;Final INT8 valid: out_last = done = 1.&lt;br&gt;Keep ready low. Return to IDLE on the next edge." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#f1eafd;strokeColor=#7551a1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1000" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="label0" value="valid start" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1280" y="285" width="80.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="sum_valid" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1280" y="390" width="85.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="div_in_ready" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1280" y="640" width="104.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label3" value="div_out_valid and final element" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1280" y="795" width="233.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label4" value="more" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="815" y="600" width="48.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="label5" value="to IDLE" style="text;html=0;align=left;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1550" y="600" width="65.0" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>